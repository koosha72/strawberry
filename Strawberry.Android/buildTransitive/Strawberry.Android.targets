<Project>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == 'Android'">

    <AndroidNativeLibrary Include="$(MSBuildThisFileDirectory)..\android\arm64-v8a\libopenal.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>

    <AndroidNativeLibrary Include="$(MSBuildThisFileDirectory)..\android\armeabi-v7a\libopenal.so">
      <Abi>armeabi-v7a</Abi>
    </AndroidNativeLibrary>

    <AndroidNativeLibrary Include="$(MSBuildThisFileDirectory)..\android\x86_64\libopenal.so">
      <Abi>x86_64</Abi>
    </AndroidNativeLibrary>

  </ItemGroup>

</Project>